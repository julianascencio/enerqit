include README.md LICENSE NOTICE CHANGELOG.md CONTRIBUTING.md ROADMAP.md uv.lock Makefile
recursive-include enerqit/data *.json *.csv
recursive-include docs *.rst *.py *.ipynb *.css *.svg *.jpg
recursive-include tests *.py
recursive-include benchmarks *.py *.md *.jsonl
recursive-include ci *.py *.sh
recursive-include paper *.md
recursive-include validation *.md *.json
exclude docs/sphinx/source/sg_execution_times.rst
prune docs/_build
prune docs/sphinx/source/auto_examples
prune docs/sphinx/source/gallery
global-exclude __pycache__ *.py[cod]
